FROM python:3.12-slim AS builder

ARG SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0

WORKDIR /build

COPY pyproject.toml .
COPY src/ src/

RUN SETUPTOOLS_SCM_PRETEND_VERSION=${SETUPTOOLS_SCM_PRETEND_VERSION} \
    pip install --no-cache-dir build && \
    SETUPTOOLS_SCM_PRETEND_VERSION=${SETUPTOOLS_SCM_PRETEND_VERSION} \
    python -m build --wheel --outdir /build/dist


FROM python:3.12-slim

LABEL org.opencontainers.image.source="https://github.com/faisyl/ebook-sorter"

# System deps reused from Dockerfile: calibre, 7z, djvused, tesseract
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        tesseract-ocr \
        djvulibre-bin \
        p7zip-full \
        calibre \
    && rm -rf /var/lib/apt/lists/* /usr/share/doc/* /usr/share/man/*

COPY --from=builder /build/dist/*.whl /tmp/
RUN WHL="$(ls /tmp/*.whl)" && pip install --no-cache-dir "${WHL}[web]" && rm /tmp/*.whl

ENV BOOKS_ROOT=/books OUTPUT_ROOT=/output APP_DATA=/data PORT=8080

VOLUME ["/books", "/output", "/data"]

EXPOSE 8080

CMD ["uvicorn", "ebook_sorter.web:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080"]
