# Copy to .env and fill in before running `docker compose up` with docker-compose.yml.
APP_PASSWORD=changeme
APP_SECRET=change-me-in-production

# Optional: Google Books API key. Without it, anonymous lookups get rate
# limited (HTTP 429) and preview becomes very slow. Create a free key at
# https://console.cloud.google.com/ (enable "Books API"), then set it here.
GOOGLE_BOOKS_API_KEY=

# Optional lookup tuning (defaults shown). Lower = fail faster on rate limits.
EBOOK_SORTER_MAX_RETRIES=2
EBOOK_SORTER_MAX_BACKOFF=3
